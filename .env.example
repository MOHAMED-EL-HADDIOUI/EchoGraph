# === App ===
APP_ENV=development

# === LLM ===
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_ANSWER_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
MAX_EXTRACTION_ERRORS=20

# === Prompts (bumped deliberately; recorded in run metadata + eval reports) ===
EXTRACTION_PROMPT_VERSION=v1
ANSWER_PROMPT_VERSION=v1

# === Chunking ===
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
MAX_CHUNKS=10

# === Graph Database ===
GRAPH_BACKEND=networkx          # "networkx" (zero-dep dev) or "neo4j"
NETWORKX_PATH=./echograph_data.json
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# === Relational Database ===
DATABASE_URL=sqlite+aiosqlite:///./echograph.db
# Postgres production example:
# DATABASE_URL=postgresql+asyncpg://echograph:echograph@localhost:5432/echograph

# === Redis (optional, for Celery) ===
REDIS_URL=redis://localhost:6379/0

# === Transcription ===
WHISPER_MODE=api                # "api" (OpenAI) or "local" (faster-whisper)
WHISPER_MODEL=whisper-1

# === Server ===
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
# Empty = open server (dev). Set in any shared deployment (X-API-Key header).
API_KEY=
MAX_TEXT_CHARS=50000
MAX_AUDIO_BYTES=26214400
# false = extract inline in POST /process. true = enqueue to Celery (needs
# Redis + a running worker, returns 202).
USE_BACKGROUND_JOBS=false

# === Embeddings (deduplication stays off until evaluated) ===
ENABLE_EMBEDDING_DEDUP=false
EMBEDDING_DEDUP_THRESHOLD=0.85
ENABLE_EXTRACTION_CACHE=false
