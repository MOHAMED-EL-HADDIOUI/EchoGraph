# === LLM ===
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EXTRACTION_TIMEOUT_S=60
ENABLE_EMBEDDING_DEDUP=false
EMBEDDING_DEDUP_THRESHOLD=0.85

# === Graph Database ===
GRAPH_BACKEND=networkx          # "networkx" (zero-dep dev) or "neo4j"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# === Relational Database ===
DATABASE_URL=sqlite+aiosqlite:///./echograph.db

# === Redis (optional, for Celery) ===
REDIS_URL=redis://localhost:6379/0

# === Transcription ===
WHISPER_MODE=api                # "api" (OpenAI) or "local" (faster-whisper)

# === Server ===
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
# Empty = open server (dev). Set in any shared deployment (X-API-Key header).
API_KEY=
MAX_INGESTION_CHARS=50000
